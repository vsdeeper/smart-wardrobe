# 本地环境变量（复制为 .env.local 后填入真实值，.env.local 已被 gitignore，勿提交密钥）
#
# cp .env.local.example .env.local

# 小程序 / 云开发（pnpm dev:weapp、pnpm build:weapp 均会读取）
# TARO_APP_ID=
# TARO_APP_CLOUD_ENV=

# 离线 Ark 联调（pnpm generate:model-templates / test:recognize-display）
# DOUBAO_API_KEY=
# DOUBAO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_SEED_MODEL=doubao-seed-2-0-lite-260428
# DOUBAO_VISION_MODEL=doubao-seedream-5-0-260128
# DOUBAO_SEED_TEMPERATURE=0.1
