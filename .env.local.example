# 本地环境变量（复制为 .env.local 后填入真实值，.env.local 已被 gitignore，勿提交密钥）
#
# cp .env.local.example .env.local

# 小程序 / 云开发（pnpm dev:weapp、pnpm build:weapp 均会读取）
# TARO_APP_ID=
# TARO_APP_CLOUD_ENV=

# 离线生成模特模板（pnpm generate:model-templates）
# DOUBAO_API_KEY=
# DOUBAO_VISION_MODEL=
# DOUBAO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_VISION_SIZE=1920x1920
