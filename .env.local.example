# 离线生成模特模板候选图（pnpm generate:model-templates）
# 复制为 .env.local 后填入真实值（.env.local 已被 gitignore，勿提交密钥）
#
# cp .env.local.example .env.local

DOUBAO_API_KEY=
DOUBAO_SEEDREAM_MODEL=doubao-seedream-5-0-260128
DOUBAO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 试穿 Hero / 模特模板候选图均为竖版；generate:model-templates 脚本固定 1600x2304，此项仅影响其它 Seedream 调用
DOUBAO_SEEDREAM_SIZE=1600x2304
