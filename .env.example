# ---------------------------------------------------------------------------
# 大模型 API Key 配置在云函数环境变量中（勿写在此处），部署 chat 后于
# 云开发控制台 → 云函数 → chat → 配置 → 环境变量 填写：
#
# LLM_DEFAULT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DOUBAO_API_KEY=...
# DOUBAO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-1-5-pro-32k-250115
#
# recognize-clothing / generate-tryon-image 云函数环境变量：
# DOUBAO_SEED_MODEL=doubao-seed-2-0-lite-260428
# DOUBAO_SEED_TEMPERATURE=0.1             # 可选，仅 recognize-clothing
#
# 和风天气 Key 配置在云函数 weather 的环境变量中（勿写在此处）：
# QWEATHER_API_KEY=...
