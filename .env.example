TARO_APP_ID=wx41fc2bff5cd34cd7

# 微信云开发环境 ID
TARO_APP_CLOUD_ENV=cloudbase-d6gkz1xlx9adbfe51

# 复制为 .env.development 后本地开发生效
# cp .env.example .env.development

# ---------------------------------------------------------------------------
# 大模型 API Key 配置在云函数环境变量中（勿写在此处），部署 chat 后于
# 云开发控制台 → 云函数 → chat → 配置 → 环境变量 填写：
#
# LLM_DEFAULT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DOUBAO_API_KEY=...
# DOUBAO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-1-5-pro-32k-250115
#
# recognize-clothing 云函数环境变量（仅 Seed 识别）：
# DOUBAO_SEED_MODEL=doubao-seed-2-0-lite-260428
# DOUBAO_SEED_TEMPERATURE=0.1             # 可选
#
# generate-wardrobe-display 云函数环境变量（Seedream 展示图）：
# DOUBAO_SEEDREAM_MODEL=doubao-seedream-5-0-260128
# DOUBAO_ITEM_DISPLAY_SIZE=1920x1920       # 可选，衣橱单品展示图（1:1）；默认 1920x1920（Seedream 像素下限 3686400）
#
# recommend-outfit 云函数环境变量（与 recognize-clothing 共用 Seed 模型）：
# DOUBAO_SEED_MODEL=doubao-seed-2-0-lite-260428
# DOUBAO_SEED_TEMPERATURE=0.3             # 可选，推荐默认 0.3
#
# generate-tryon-image 云函数环境变量（Hero 试穿图，调用 /images/generations）：
# DOUBAO_SEEDREAM_MODEL=doubao-seedream-5-0-260128
# DOUBAO_SEEDREAM_SIZE=1600x2304             # 可选，默认 1600x2304（Hero 335×480，Seedream 5.0 最小合规尺寸）
#
# 离线生成模特模板（pnpm generate:model-templates）：复制 .env.local.example → .env.local，填入 DOUBAO_API_KEY 等
#
# 和风天气 Key 配置在云函数 weather 的环境变量中（勿写在此处）：
# QWEATHER_API_KEY=...
